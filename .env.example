# Local development. Use your own credentials in .env.local.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bridgemate_app
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=bridgemate
# Local MySQL may not have TLS. Set true for remote MySQL on Vercel.
MYSQL_SSL=false
# Optional provider CA certificate, PEM text with actual newlines or escaped \n.
# MYSQL_SSL_CA=

# AI keys are server-only. Never use a NEXT_PUBLIC_ prefix.
# Default: Gemini. Use a Google AI Studio project on the free tier.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_ENABLED=true
AI_DAILY_LIMIT=30
# Optional paid alternative, enabled only by explicitly setting AI_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
