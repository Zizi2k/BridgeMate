# Local development. Use your own credentials in .env.local.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bridgemate_app
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=bridgemate
# Local MySQL may not have TLS. Set true for remote MySQL on Vercel.
MYSQL_SSL=false
# Optional provider CA certificate, PEM text with actual newlines or escaped \n.
# MYSQL_SSL_CA=
