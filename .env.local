# Cấu hình kết nối MySQL (mặc định XAMPP trên máy tính)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=bridgemate
MYSQL_SSL=false

# Cấu hình AI Gemini (tùy chọn - nếu cần dùng trợ lý AI)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_ENABLED=true
AI_DAILY_LIMIT=30
